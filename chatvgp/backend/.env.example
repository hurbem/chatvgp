# Database
DATABASE_URL=postgresql://user:password@localhost:5432/chatvgp

# JWT (chave de assinatura dos tokens)
SECRET_KEY=gere-com-secrets.token_urlsafe-32

# Senha de login do admin (diferente da SECRET_KEY, mín. 16 caracteres)
ADMIN_PASSWORD=gere-outra-chave-aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Claude API
CLAUDE_API_KEY=your-claude-api-key

# Environment
ENVIRONMENT=development
DEBUG=False

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
